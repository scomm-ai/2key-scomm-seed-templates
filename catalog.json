{
	"$schema": "./schemas/catalog.schema.json",
	"schemaVersion": 1,
	"surfaces": ["scomm", "office"],
	"platforms": ["linux"],
	"hosts": {
		"scommDesktop": {
			"surfaces": ["scomm"],
			"excludePlatforms": ["linux"]
		},
		"scommLinux": {
			"surfaces": ["scomm"]
		},
		"office": {
			"surfaces": ["office"],
			"excludePlatforms": ["linux"]
		}
	},
	"products": {
		"Scomm": {
			"description": "Optional Scomm add-ons: Linux, Local-AI, SComm Connect, Outlook OpenPGP ECC, Outlook OpenPGP ECC+PQC, accent colours, and related features",
			"isActive": true,
			"meters": {
				"scomm.ai.tokens": {
					"displayName": "Scomm AI tokens",
					"unit": "token",
					"aggregation": "sum",
					"description": "Prepaid AI inference tokens for Scomm assistants"
				}
			},
			"offerings": {
				"pgp": {
					"displayName": "Outlook OpenPGP ECC",
					"resources": {
						"addonCode": "pgp",
						"surfaces": ["office"]
					}
				},
				"pqc": {
					"displayName": "Outlook OpenPGP ECC+PQC",
					"resources": {
						"addonCode": "pqc",
						"surfaces": ["scomm", "office"]
					}
				},
				"linux": {
					"displayName": "Linux Version",
					"resources": {
						"addonCode": "linux",
						"surfaces": ["scomm"],
						"platforms": ["linux"]
					}
				},
				"ai_assistant": {
					"displayName": "Local-AI",
					"resources": {
						"addonCode": "ai_assistant",
						"surfaces": ["scomm", "office"]
					}
				},
				"scomm_connector": {
					"displayName": "SComm Connect",
					"resources": {
						"addonCode": "scomm_connector",
						"surfaces": ["scomm", "office"],
						"maxDevices": 5
					}
				},
				"accent_color": {
					"displayName": "Custom Colours & Backgrounds",
					"resources": {
						"addonCode": "accent_color",
						"surfaces": ["scomm"]
					}
				},
				"ai_tokens_1m": {
					"displayName": "AI Tokens 1M",
					"resources": {
						"surfaces": ["scomm"],
						"usageGrants": {
							"scomm.ai.tokens": { "quantity": 1000000 }
						},
						"validity_days": 30
					}
				}
			},
			"plans": {
				"Outlook OpenPGP ECC": {
					"description": "Classical OpenPGP (ECC) encrypt, sign, and key publish in the Outlook add-in.",
					"trialDays": 0,
					"offeringCodes": ["pgp"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"Outlook OpenPGP ECC+PQC": {
					"description": "Post-quantum cryptography for Scomm Email and the Outlook add-in. One seat unlocks PQC on both surfaces.",
					"trialDays": 0,
					"offeringCodes": ["pqc"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 15 }
					}
				},
				"Linux Version": {
					"description": "Run SCOMM.AI natively on Linux distributions. Full feature parity with Windows and macOS versions.",
					"trialDays": 0,
					"offeringCodes": ["linux"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"Local-AI": {
					"description": "Run AI models locally on your device for enhanced privacy and offline capabilities.",
					"trialDays": 30,
					"offeringCodes": ["ai_assistant"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"SComm Connect": {
					"description": "Sync and access your communications across up to 5 devices seamlessly.",
					"trialDays": 30,
					"offeringCodes": ["scomm_connector"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"Custom Colours & Backgrounds": {
					"description": "Unlock the full colour spectrum for accent colours and custom background gradients.",
					"trialDays": 30,
					"offeringCodes": ["accent_color"],
					"pricings": {
						"annual": { "currency": "USD", "basePrice": 5 }
					}
				},
				"AI Tokens 1M": {
					"description": "Prepaid 1,000,000 AI tokens (30-day validity). Top up anytime.",
					"trialDays": 0,
					"offeringCodes": ["ai_tokens_1m"],
					"pricings": {
						"monthly": { "currency": "USD", "basePrice": 10 }
					}
				}
			}
		}
	}
}
